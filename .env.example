# Model provider selection.
#   mock      -> deterministic MockLanguageModel, no credentials needed (default)
#   opencode  -> use the model already selected in OpenCode's /models setting,
#                invoked through `opencode run`. No separate API key required.
#   disabled  -> model calls forbidden; only deterministic/no-LLM paths run.
MODEL_PROVIDER=mock
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=

# Storage
DATABASE_PATH=data/agent.db

# Wandering bounds
MAX_WANDER_HYPOTHESES=5
MAX_WANDER_MEMORIES=8
WANDER_TOKEN_BUDGET=2000
WANDER_INTERVAL_SECONDS=0

# Optional scheduler limits (manual mode is the default)
MAX_RUNS_PER_HOUR=4
DRY_RUN=false